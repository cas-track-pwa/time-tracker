# Copy to .env and fill in. .env is gitignored.
PORT=8787

# HMAC secret for signing auth tokens. Reuse the Worker's JWT_SECRET to keep
# existing sessions/devices working after migrating off Cloudflare.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# SQLite database file. Put it on a persistent volume.
DB_PATH=./data/tt.sqlite

# JSON array of allowed registration/login emails. Single-quote it so the quotes
# survive both systemd's EnvironmentFile and Node's --env-file parsing.
FALLBACK_ALLOWED_USERS='["you@example.com"]'

# Leave empty when the API is served same-origin behind the reverse proxy.
# Set to the PWA origin only for cross-origin dev.
ALLOWED_ORIGIN=
